{
  "meta": {
    "name": "Northlight Studio",
    "description": "A design and engineering studio building products for ambitious startups.",
    "industry": "agency",
    "tone": "professional",
    "siteUrl": "https://northlight.studio"
  },
  "siteType": "agency",
  "designSystem": {
    "style": "gradient-vibrant",
    "colors": {
      "mode": "light",
      "primary": "#111111",
      "secondary": "#6b7280",
      "accent": "#3b82f6",
      "neutral": "#f5f5f5",
      "background": "#ffffff",
      "surface": "#fafafa"
    },
    "typography": { "headingFont": "Space Grotesk", "bodyFont": "Inter", "scale": "comfortable" },
    "radius": "md",
    "density": "regular",
    "shadowIntensity": "subtle"
  },
  "animations": { "level": "moderate", "scrollReveal": true, "hoverEffects": true, "library": "framer-motion" },
  "pages": [
    {
      "path": "/",
      "name": "Home",
      "isHome": true,
      "description": "Test page exercising every newly added component variant.",
      "sections": [
        { "type": "navbar", "layout": "floating-pill", "componentHint": "navbar.floating-pill", "content": {
          "logoText": "Northlight",
          "links": [{ "label": "Work", "href": "#work" }, { "label": "Pricing", "href": "#pricing" }],
          "ctaLabel": "Start a project", "ctaHref": "#contact"
        }},
        { "type": "hero", "layout": "gradient-minimal", "componentHint": "hero.gradient-minimal", "content": {
          "eyebrow": "Design & engineering studio",
          "heading": "We build products people actually want to use",
          "subheading": "From prototype to production launch.",
          "primaryCtaLabel": "Start a project"
        }},
        { "type": "logo-cloud", "layout": "bordered-grid", "componentHint": "logo-cloud.bordered-grid", "content": {
          "heading": "Trusted by teams at"
        }},
        { "type": "stats", "layout": "counter-cards", "componentHint": "stats.counter-cards", "content": {
          "heading": "By the numbers"
        }},
        { "type": "pricing", "layout": "toggle-tiers", "componentHint": "pricing.toggle-tiers", "content": {
          "heading": "Simple, transparent pricing"
        }},
        { "type": "comparison-table", "layout": "tiered-cards", "componentHint": "comparison-table.tiered-cards", "content": {
          "heading": "Compare engagement types"
        }},
        { "type": "faq", "layout": "card-grid", "componentHint": "faq.card-grid", "content": {
          "heading": "Frequently asked questions"
        }},
        { "type": "testimonials", "layout": "carousel", "componentHint": "testimonials.carousel", "content": {
          "heading": "What clients say"
        }},
        { "type": "team", "layout": "side-list", "componentHint": "team.side-list", "content": {
          "heading": "Meet the team"
        }},
        { "type": "gallery", "layout": "filterable-grid", "componentHint": "gallery.filterable-grid", "content": {
          "heading": "Selected work"
        }},
        { "type": "steps-process", "layout": "vertical-timeline", "componentHint": "steps-process.vertical-timeline", "content": {
          "heading": "How we work"
        }},
        { "type": "cta", "layout": "gradient-split", "componentHint": "cta.gradient-split", "content": {
          "heading": "Ready to get started?"
        }},
        { "type": "contact", "layout": "centered-simple", "componentHint": "contact.centered-simple", "content": {
          "heading": "Let's build something",
          "email": "hello@northlight.studio"
        }},
        { "type": "footer", "layout": "split-social", "componentHint": "footer.split-social", "content": {
          "logoText": "Northlight",
          "githubUrl": "https://github.com",
          "twitterUrl": "https://twitter.com"
        }}
      ]
    }
  ]
}
